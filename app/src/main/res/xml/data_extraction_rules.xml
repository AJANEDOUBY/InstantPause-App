<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- CoolDown ne sauvegarde rien dans le cloud -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>

    <!-- CoolDown ne transfère rien vers un nouvel appareil -->
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>