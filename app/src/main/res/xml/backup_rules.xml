<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegarde pour Android 11 et antérieurs.
  Équivalent de data_extraction_rules.xml (Android 12+) : Instant Pause ne sauvegarde
  et ne transfère rien. android:allowBackup="false" coupe déjà la sauvegarde, mais
  Android 12+ exige aussi dataExtractionRules pour le transfert d'appareil à appareil.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
