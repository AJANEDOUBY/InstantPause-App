<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions : notifications + vibration -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        Écran de pause en plein écran quand un appel est bloqué. Sur Android 14+, cette
        permission n'est accordée d'office qu'aux apps dont le cœur de métier est l'alarme
        ou les appels ; les autres doivent obtenir le consentement de l'utilisateur.
        L'app vérifie donc NotificationManager.canUseFullScreenIntent() au démarrage et
        ouvre les réglages dédiés si nécessaire (MainActivity).
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Redémarrage du téléphone -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ré-armement du veilleur après redémarrage (alarme exacte, avec repli inexact) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Invitation à exclure l'app de l'optimisation batterie -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Foreground Services (Android 14+) -->
    <!--
        Type `specialUse` pour les trois services (pause, minuteur, veille) : aucun des
        types standard ne couvre le blocage d'appel par une app tierce. Le sous-type est
        justifié dans le manifeste via PROPERTY_SPECIAL_USE_FGS_SUBTYPE ; Play Console
        demande en plus une justification écrite (formulaire) si l'app y est publiée.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        Raccrochage automatique à la fin des 3 minutes d'un appel autorisé.
        ANSWER_PHONE_CALLS est la seule permission qui ouvre TelecomManager.endCall()
        à une application tierce. Elle est OBLIGATOIRE : demandée pendant l'installation,
        l'app ne s'ouvre pas sans elle (sinon la limite n'est qu'un rappel visuel).
    -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <application
        android:name=".CoolDownApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoolDown"
        tools:targetApi="35">

        <!-- Activité principale (écran d'accueil) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran de pause sensoriel (s'affiche lors d'un appel bloqué) -->
        <activity
            android:name=".ui.pause.PauseActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CoolDown" />

        <!-- Service d'interception des appels sortants (Android Telecom) -->
        <service
            android:name=".system.CoolDownCallRedirectionService"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>

        <!-- Foreground Service ultra-court : ouvre PauseActivity depuis l'arrière-plan -->
        <service
            android:name=".system.PauseForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="blocking_impulsive_calls" />
        </service>

        <!-- Minuteur des appels autorisés : pastille + notification, sans couper la ligne -->
        <service
            android:name=".system.CallTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="countdown_for_trusted_contacts_calls" />
        </service>

        <!-- Service de veille : maintient l'app en vie sur les téléphones agressifs -->
        <service
            android:name=".system.CoolDownWatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="call_protection_watchdog" />
        </service>
        <!-- Administrateur d'appareil : uniquement pour freiner la désinstallation -->
        <receiver
            android:name=".system.CoolDownDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
        </receiver>

        <!-- Récepteur au démarrage du téléphone (exported=true OBLIGATOIRE) -->
        <receiver
            android:name=".system.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>