<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions : notifications + vibration -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        Mode « Ne pas déranger » optionnel pendant les plages (voir docs/DND-1.6.0.md).
        Permission de niveau normal, mais l'accès reste soumis à un accord explicite
        dans les réglages système : l'app ne le demande jamais d'elle-même.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!--
        Écran de pause en plein écran quand un appel est bloqué. Sur Android 14+, cette
        permission n'est accordée d'office qu'aux apps dont le cœur de métier est l'alarme
        ou les appels ; les autres doivent obtenir le consentement de l'utilisateur.
        L'app vérifie donc NotificationManager.canUseFullScreenIntent() au démarrage et
        ouvre les réglages dédiés si nécessaire (MainActivity).
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Redémarrage du téléphone -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Réveil au début ou à la fin d'une plage, pour recaler le filtre « Ne pas
        déranger ». Aucune permission spéciale n'est requise : l'alarme est exacte
        quand le système l'autorise, sinon elle glisse de quelques minutes.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Foreground Services (Android 14+) -->
    <!--
        Type `specialUse` pour les deux services (pause, minuteur) : aucun des
        types standard ne couvre le blocage d'appel par une app tierce. Le sous-type
        est justifié dans le manifeste via PROPERTY_SPECIAL_USE_FGS_SUBTYPE ; Play
        Console demande en plus une justification écrite (formulaire) si l'app y est
        publiée.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        Raccrochage automatique à la fin des 3 minutes d'un appel autorisé.
        ANSWER_PHONE_CALLS est la seule permission qui ouvre TelecomManager.endCall()
        à une application tierce. Elle est OPTIONNELLE : refusée, l'app fonctionne
        toujours (le minuteur reste visible) mais ne coupe pas la ligne ; l'écran
        Sécurité permet de l'accorder plus tard.
    -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <application
        android:name=".CoolDownApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoolDown"
        tools:targetApi="35">

        <!-- Activité principale (écran d'accueil) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran de pause sensoriel (s'affiche lors d'un appel bloqué) -->
        <activity
            android:name=".ui.pause.PauseActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CoolDown" />

        <!-- Service d'interception des appels sortants (Android Telecom) -->
        <service
            android:name=".system.CoolDownCallRedirectionService"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>

        <!-- Foreground Service ultra-court : ouvre PauseActivity depuis l'arrière-plan -->
        <service
            android:name=".system.PauseForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="blocking_impulsive_calls" />
        </service>

        <!-- Minuteur des appels autorisés : pastille + notification, sans couper la ligne -->
        <service
            android:name=".system.CallTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="countdown_for_trusted_contacts_calls" />
        </service>
        <!-- Réveil au prochain changement d'état (début/fin de plage, fin du Zen) -->
        <receiver
            android:name=".system.ProtectionAlarmReceiver"
            android:exported="false" />
        <!-- Récepteur au démarrage du téléphone. Non exporté : Android livre malgré tout
             BOOT_COMPLETED et MY_PACKAGE_REPLACED au récepteur de l'application. -->
        <receiver
            android:name=".system.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>